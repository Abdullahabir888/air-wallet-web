{
  "name": "air-wallet-functions",
  "version": "1.0.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest --testPathIgnorePatterns rules",
    "test:rules": "jest test/rules.test.ts --runInBand",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,storage",
    "deploy": "npm run build && firebase deploy --only functions"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/jest": "^30.0.0",
    "esbuild": "^0.28.2",
    "firebase": "^13.1.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@air-wallet/core$": "<rootDir>/../packages/core/src/index.ts",
      "^@air-wallet/validation$": "<rootDir>/../packages/validation/src/index.ts"
    }
  }
}
