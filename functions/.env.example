# Copy to functions/.env (or .env.<projectId>) — non-secret Functions config.
# Secrets (EXCHANGE_API_KEY) go in Secret Manager:  firebase functions:secrets:set EXCHANGE_API_KEY

# Region for all functions (closest to Bangladesh: asia-south1 = Mumbai).
FUNCTIONS_REGION=asia-south1

# Turn on only after BOTH web (reCAPTCHA Enterprise) and native (React Native Firebase App Check)
# send App Check tokens. Otherwise legitimate mobile requests will be rejected.
APP_CHECK_ENFORCE=false
