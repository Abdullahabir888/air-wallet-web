# Copy to .env and fill from Firebase console → Project settings → Your apps → Web app.
# These are public client identifiers, not secrets.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FUNCTIONS_REGION=asia-south1

# Web App Check (reCAPTCHA Enterprise site key). Leave empty to skip App Check.
EXPO_PUBLIC_RECAPTCHA_ENTERPRISE_KEY=

# Local development against the Firebase Emulator Suite (npm run emulators).
# Use your computer's LAN IP instead of 127.0.0.1 when testing on a phone.
EXPO_PUBLIC_USE_EMULATORS=true
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1

# Google sign-in (Firebase console → Authentication → Google → Web SDK configuration).
# Web client ID is required on Android/iOS so Google returns an ID token Firebase accepts.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS OAuth client ID (Google Cloud console → Credentials → iOS client for com.airwallet.app)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed iOS client ID, used at BUILD time by the config plugin (not EXPO_PUBLIC)
GOOGLE_IOS_URL_SCHEME=
