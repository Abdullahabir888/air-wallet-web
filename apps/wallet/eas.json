{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_ENV": "development" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "APP_ENV": "preview", "EXPO_PUBLIC_USE_EMULATORS": "false" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "APP_ENV": "production", "EXPO_PUBLIC_USE_EMULATORS": "false" }
    }
  },
  "submit": {
    "production": {
      "android": { "track": "internal" },
      "ios": {}
    }
  }
}
